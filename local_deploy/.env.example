# Cloudflare Tunnel (reuses existing tunnel on this machine)
CF_API_TOKEN=your-api-token
CF_ACCOUNT_ID=your-account-id
CF_ZONE_ID=your-zone-id
CF_DOMAIN=yourdomain.com
CF_SUBDOMAIN=tychos
CF_ACCESS_EMAILS=user@example.com,another@example.com

# App
TYCHOS_DIR=/Users/you/Projects/tychos
TYCHOS_PORT=8000
TYCHOS_ADMIN_USER=admin@tychos.local
TYCHOS_ADMIN_PASSWORD=changeme

# Postgres
#
# Production: points at the single deployed DB.
# Development / worktrees: every worktree and every clone MUST use its own DB
#   name — never share a DB across branches. A shared DB silently corrupts runs
#   when another worktree resets or mutates state concurrently, and tests that
#   hit a shared DB do not prove anything about the code under test.
#
# Convention: tychos_<branch-slug> for dev, tychos_<branch-slug>_test for tests.
#   psql postgres -c "CREATE DATABASE tychos_<branch-slug> OWNER tychos;"
#   psql postgres -c "CREATE DATABASE tychos_<branch-slug>_test OWNER tychos;"
DATABASE_URL=postgres://tychos:tychos@localhost:5432/tychos

# Anthropic API (required for researcher daemon)
ANTHROPIC_API_KEY=sk-ant-...
